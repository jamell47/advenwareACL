generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  AGENT
  ADMIN
  SUPPORT
  FINANCE
  PLACEMENT_ADMIN
  DOCUMENT_ADMIN
  SUPER_ADMIN
  AGENT_MANAGER
  PARTNERSHIP_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum IDType {
  NATIONAL_ID
  PASSPORT
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  STUDENT_ID
  PASSPORT_PHOTO
  ATTACHMENT_LETTER
  INTRODUCTION_LETTER
  CV
  ACADEMIC_CERTIFICATE
  TRANSCRIPT
  RECOMMENDATION_LETTER
  OTHER_CERTIFICATE
  OTHER_DOCUMENT
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REUPLOAD_REQUIRED
}

enum ApplicationStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  SEARCHING
  MATCHED
  PLACEMENT_CONFIRMED
  CANCELLED
}

enum PlacementStatus {
  SEARCHING
  MATCHED
  CONFIRMED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  CARD
  BANK_TRANSFER
}

enum ConversationParticipantRole {
  STUDENT
  AGENT
  SUPPORT
  ADMIN
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  SUCCESS
  FAILED
  REJECTED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum NotificationType {
  APPLICATION_RECEIVED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  PLACEMENT_CONFIRMED
  PAYMENT_REQUIRED
  PAYMENT_SUCCESSFUL
  MESSAGE_RECEIVED
  SUPPORT_REPLY
  SYSTEM
}

enum CommissionStatus {
  PENDING
  ELIGIBLE
  PAID
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phoneNumber  String?    @unique
  passwordHash String
  firstName    String
  middleName   String?
  lastName     String
  profileImage String?
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(PENDING_VERIFICATION)
  isActive     Boolean    @default(true)
  agentId      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  // Relations
  studentProfile   StudentProfile?
  agentProfile     AgentProfile?
  agent            User?                     @relation("AgentStudents", fields: [agentId], references: [id])
  students         User[]                    @relation("AgentStudents")
  sentMessages     Message[]                 @relation("SentMessages")
  receivedMessages Message[]                 @relation("ReceivedMessages")
  conversations    ConversationParticipant[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  payments         Payment[]
  placements       Placement[]
  applications     AttachmentApplication[]
  documents        Document[]
  refreshTokens    RefreshToken[]
  commissions      Commission[]
  withdrawals      Withdrawal[]

  @@index([email])
  @@index([phoneNumber])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model StudentProfile {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  dateOfBirth               DateTime?
  nationality               String?
  gender                    Gender?
  idNumber                  String?
  idType                    IDType?
  studentRegistrationNumber String?
  institution               String?
  course                    String?
  department                String?
  currentYear               String?
  expectedGraduation        DateTime?
  preferredStartDate        DateTime?
  preferredEndDate          DateTime?
  preferredLocation         String?
  preferredIndustry         String?
  preferredPlacementArea    String?
  profileCompleteness       Int?      @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user        User                   @relation(fields: [userId], references: [id])
  educations  Education[]
  documents   Document[]
  application AttachmentApplication?

  @@index([userId])
  @@map("student_profiles")
}

model Education {
  id               String    @id @default(uuid())
  studentProfileId String
  institution      String
  course           String
  department       String?
  startDate        DateTime?
  endDate          DateTime?
  gpa              String?
  isCurrent        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])

  @@index([studentProfileId])
  @@map("educations")
}

model AttachmentApplication {
  id                     String            @id @default(uuid())
  userId                 String
  studentProfileId       String?           @unique
  preferredStartDate     DateTime?
  preferredEndDate       DateTime?
  preferredLocation      String?
  preferredIndustry      String?
  preferredPlacementArea String?
  coverLetter            String?
  resumeLink             String?
  status                 ApplicationStatus @default(DRAFT)
  adminNotes             String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  reviewedAt             DateTime?
  reviewedBy             String?

  user           User            @relation(fields: [userId], references: [id])
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])
  placement      Placement?

  @@index([userId])
  @@index([status])
  @@map("attachment_applications")
}

model Document {
  id               String         @id @default(uuid())
  userId           String
  studentProfileId String?
  applicationId    String?
  type             DocumentType
  customTypeName   String?
  fileName         String
  fileSize         Int
  mimeType         String
  filePath         String?
  status           DocumentStatus @default(PENDING_REVIEW)
  isRequired       Boolean        @default(false)
  uploadedAt       DateTime       @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  studentProfile StudentProfile?   @relation(fields: [studentProfileId], references: [id])
  versions       DocumentVersion[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  filePath   String
  fileName   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([version])
  @@map("document_versions")
}

model Placement {
  id                 String          @id @default(uuid())
  userId             String
  applicationId      String?         @unique
  organizationId     String?
  organizationName   String
  department         String?
  positionTitle      String
  location           String
  supervisorName     String?
  supervisorPhone    String?
  supervisorEmail    String?
  startDate          DateTime
  endDate            DateTime
  status             PlacementStatus @default(SEARCHING)
  placementFee       Decimal?        @db.Decimal(10, 2)
  feeAmount          Int?            @default(1500)
  commissionAmount   Int?            @default(500)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  confirmedAt        DateTime?
  matchedAt          DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  user         User                   @relation(fields: [userId], references: [id])
  application  AttachmentApplication? @relation(fields: [applicationId], references: [id])
  payment      Payment?
  organization Organization?          @relation(fields: [organizationId], references: [id])
  commissions  Commission[]

  @@index([userId])
  @@index([applicationId])
  @@index([organizationId])
  @@index([status])
  @@map("placements")
}

model Payment {
  id                 String        @id @default(uuid())
  userId             String
  placementId        String?       @unique
  amount             Int
  currency           String        @default("KES")
  method             PaymentMethod @default(MPESA)
  status             PaymentStatus @default(PENDING)
  mpesaPhoneNumber   String?
  mpesaReceiptNumber String?
  transactionId      String?
  checkoutRequestId  String?
  darajaResponse     Json?
  callbackData       Json?
  confirmedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  placement Placement? @relation(fields: [placementId], references: [id])

  @@index([userId])
  @@index([placementId])
  @@index([status])
  @@index([checkoutRequestId])
  @@map("payments")
}

model Conversation {
  id            String   @id @default(uuid())
  studentId     String
  agentId       String?
  supportId     String?
  subject       String?
  isResolved    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageId String?  @unique

  participants ConversationParticipant[]
  messages     Message[]
  lastMessage  Message?                  @relation("LastMessage", fields: [lastMessageId], references: [id])

  @@index([studentId])
  @@index([agentId])
  @@index([supportId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String                      @id @default(uuid())
  conversationId String
  userId         String
  role           ConversationParticipantRole
  joinedAt       DateTime                    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  receiverId     String
  message        String
  isRead         Boolean   @default(false)
  sentAt         DateTime  @default(now())
  readAt         DateTime?
  attachmentUrl  String?
  attachmentName String?

  conversation  Conversation  @relation(fields: [conversationId], references: [id])
  sender        User          @relation("SentMessages", fields: [senderId], references: [id])
  receiver      User          @relation("ReceivedMessages", fields: [receiverId], references: [id])
  lastMessageOf Conversation? @relation("LastMessage")

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([sentAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SupportConfig {
  id             String   @id @default(uuid())
  whatsappNumber String?
  supportEmail   String?
  faqJson        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("support_configs")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  message    String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model Commission {
  id          String           @id @default(uuid())
  placementId String
  agentId     String
  amount      Int
  currency    String           @default("KES")
  status      CommissionStatus @default(PENDING)
  eligibleAt  DateTime?
  paidAt      DateTime?
  paymentRef  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  agent     User      @relation(fields: [agentId], references: [id])
  placement Placement @relation(fields: [placementId], references: [id])

  @@index([agentId])
  @@index([placementId])
  @@index([status])
  @@map("commissions")
}

model Withdrawal {
  id         String           @id @default(uuid())
  agentId    String
  amount     Int
  currency   String           @default("KES")
  status     WithdrawalStatus @default(PENDING)
  method     String?
  phone      String?
  paidAt     DateTime?
  paymentRef String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  agent User @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([status])
  @@map("withdrawals")
}

model Organization {
  id             String             @id @default(uuid())
  name           String
  industry       String?
  location       String?
  contactPerson  String?
  phone          String?
  email          String?
  totalSlots     Int?
  availableSlots Int?               @default(0)
  website        String?
  description    String?
  status         OrganizationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  placements    Placement[]
  agentProfiles AgentProfile[]

  @@index([status])
  @@map("organizations")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  module      String

  rolePermissions RolePermission[]

  @@index([code])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_permissions")
}

model AgentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  organizationId   String?
  registrationDate DateTime @default(now())
  isApproved       Boolean  @default(true)
  commissionRate   Int?     @default(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@map("agent_profiles")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  group       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("system_settings")
}
