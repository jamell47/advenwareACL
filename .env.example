# Server
PORT=4000
NODE_ENV=development
BASE_URL=https://advenwareacl.onrender.com
FRONTEND_URL=https://advenware-ac-ladmin.vercel.app

# Database

# JWT
JWT_SECRET=__CHANGE_ME_to_a_long_random_secret__
JWT_REFRESH_SECRET=__CHANGE_ME_refresh_secret__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Daraja / M-Pesa
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://advenwareacl.onrender.com/api/v1/payments/callback
DARAJA_ENVIRONMENT=sandbox

# File Storage
# Set STORAGE_ENDPOINT to an S3-compatible URL (e.g. https://bucket.s3.amazonaws.com)
# to enable persistent cloud storage. Leave empty for local filesystem (dev only).
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=advenwareacl
STORAGE_REGION=us-east-1
UPLOAD_MAX_SIZE_MB=10

# Support
WHATSAPP_SUPPORT_NUMBER=254116144095
SUPPORT_EMAIL=info@advenware.com

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081,https://advenware-ac-ladmin.vercel.app,https://advenwareacl.onrender.com,https://acl-organisation.onrender.com,exp://192.168.100.54:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
